# Copie para .env.local (dev) e .env.prod (prod). Nunca versione os arquivos preenchidos.
# Variáveis EXPO_PUBLIC_ vão para dentro do app: só valores públicos aqui (nada de service role).

# Ambiente: dev | prod
EXPO_PUBLIC_APP_ENV=dev
# Supabase > Project Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API > anon/publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# PowerSync > Instance > Connect > Instance URL
EXPO_PUBLIC_POWERSYNC_URL=
